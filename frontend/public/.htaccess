# Site React de página única: qualquer endereço que não seja um arquivo real
# (/produtos, /perfil, /calendario?pet=3...) abre o index.html e o React Router mostra a tela.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
